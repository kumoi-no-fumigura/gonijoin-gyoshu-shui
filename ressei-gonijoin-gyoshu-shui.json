 "poems": [
  {
   "seq": "1",
   "text": "春たつと思ひあへぬにのどけきは出づる朝日や空にしるらむ",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "山ふかき谷のうぐひす出でにけりみやこの人に春や告ぐらむ",
   "kana": "",
   "speaker": "",
   "page": 165,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "のどかなるゆふべの山はみどりにて霞になびく靑柳の絲",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "淺みどりあまねき惠いろに出でて野なる草木に春雨ぞふる",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "吉野山そらもひとつに匂ふなり霞の上のはなのしらくも",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "志賀の山風をさまれる春に逢ひて君が行幸を花もまちけり",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "悔しくぞ移ろふ花をたをりつるあやなく袖の雪とふりけり",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "今ぞみる君がこころもをりをえて春の時しる花のひとえだ",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "葦火たく難波の浦の春の月けぶりのほかにかすむなりけり",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "雲雀あがる山の裾野の夕暮にわかばのしばふ春風ぞふく",
   "kana": "",
   "speaker": "集",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "くちなしのいはでの里は山吹の花さくよりや名づけそめけむ",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "櫻色の衣はうへにかふれども心に春をわすれぬものを",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "山かげや田子の小笠をふく風もすずしき暮に早苗とるなり",
   "kana": "",
   "speaker": "",
   "page": 166,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "鳴きぬべき頃と思へば時鳥ねざめに待たぬあかつきぞなき",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "初音まつ我れにてしれば時鳥人よりさきとえこそうらみね",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "時鳥その神山のそのかみもかばかり待ちし人はありきや",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "月のゆく波のしがらみかけとめよ天の河原のみじか夜の空",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "凉しさは夕暮かけてむすぶ手の袖にせかるる山のした水",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "別路のかたみもとめず夕月夜あかつきやみの星合のそら",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "幾秋かわたし來ぬらむ天の河おのがよりはのかささぎの橋",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "たなばたのちぎり待つ間の涙より露はゆふべの物とやはおく",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "山本の稻葉の末の秋の露いくよつもりて夜寒そはまし",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "更けぬれどゆくとも見えぬ月影のさすがに松の西になりぬる",
   "kana": "",
   "speaker": "",
   "page": 167,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "鶉なく野原の淺茅うちなびき夕露もろくあきかぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "藻しほやく煙もたえて松島やをじまの浪にはるる月かげ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "きりぎりすそことも見えぬ庭の面の暮れゆく草の蔭になくなり",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ながめわびぬ秋も名殘と夕日さす雲の旗手はうちしぐれつつ",
   "kana": "",
   "speaker": "載",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "秋風も夜さむに吹きぬさを鹿の妻とふ萩の花やさくらむ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "月殘る門田の面のあけがたに霧のうちなる鴫のはねがき",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "よそよりは同じ宿とぞ聞ゆらむ垣根へだてて衣うつこゑ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "今よりは衣うつなり秋風のさむきゆふべの岡のべのさと",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "いかがまたおもひすてては過すべきとまらぬ秋の別なりとも",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "もみぢ葉のみ山に深くちりしくは秋のかへりし道にやあるらむ",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "見てぞしる時雨にはあらで染むときく心の色の深き紅葉ば",
   "kana": "",
   "speaker": "",
   "page": 168,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "神なびの山下風のさむけくにちりかひ曇る四方のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "萩が花ちりにし小野の冬枯に霜のふる枝の色ぞさびしき",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "名にしおふ秋の半はすぎぬれど今宵も月はためしなりけり",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "ほにいづる荻の上風うちそよぎ入江夜さむにすめる月影",
   "kana": "",
   "speaker": "載",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "戶はまだあけやらで〓見潟そらより通ふさよ千鳥かな",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "浦遠くわたる千鳥もこゑさむし霜のしらすのありあけの空",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "網代木にいざよふ浪をたよりにて八十字治河はまづ氷りつつ",
   "kana": "",
   "speaker": "千",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さらでだにふみからしてし道のべの草を冬野に結ぶ朝霜",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さざなみや比良の山かぜさゆる日は汀こほりてよる舟もなし",
   "kana": "",
   "speaker": "",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いとどまた冬ごもりせるみよし野の吉野の奧の雪のふる〓",
   "kana": "",
   "speaker": "千報",
   "page": 169,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "磯邊なる松の下枝にふる雪のけぬとも見えずかかる白浪",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "跡つけぬほどをも見せむ庭の雪人のとふまで消えずもあらなむ",
   "kana": "",
   "speaker": "集",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "現には逢ふよもしらず見る夢をはかなしとては賴みこそせめ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "關なくてただ逢坂の山ならばへだつる中に物はおもはじ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "誠かとまたおしかへし問ふほどの人目のひまもなき契かな",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "人傳にいへどもいとどつれなきは我が思ふ程や恨みざるらむ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "戀ひ死なむ命のさきにあふといふ無き名をだにも立つと聞かばや",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "限あれば今ぞ重ぬるせきかへし涙にくちし夜はの衣手",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "關守はあかつきばかり打ちもねよ我が通路をしのぶ別に",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "言ひいでむ言の葉もなほ忍ばれて心にこむる我が思かな",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "いかにせむ世に僞のあるままに我がかねごとを人の賴まぬ",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "聞くたびにこりずぞ猶も賴まるる憂きにはなれし契なれども",
   "kana": "",
   "speaker": "",
   "page": 170,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "顯はればいかにせむとか人しれぬ我が通路の數つもるらむ",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "いとど猶なげかむ爲か逢ふと見て人なきとこの夢の名殘は",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "しばしこそ人目思ひし宵宵の忍ぶかたより絕えや果つべき",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "恨むなよ人目をなげく折折は我が心なる夜がれならぬを",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "忘れじよ今日や明日やと知らねどもいきて命のあらむかぎりは",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "今しばし忍びもはてぬくやしさもみじかかりける契にぞしる",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "蜑のすむ里のしるべやこれならむくるれば見ゆる漁火の影",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "志賀の浦や氷くだけて秋風の吹きしく浪にうかぶ月かげ",
   "kana": "",
   "speaker": "集",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "浦の松木の間に見えて沈む日の名殘の波ぞしばしうつろふ",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なごの浦にとまりをすればしきたへの枕に高き沖つしら浪",
   "kana": "",
   "speaker": "千",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "世のためもあふぐとをしれ男山むかしは神の國ならずやは",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "難波潟あしべはるかに晴るる日は聲ものどかにたづぞ鳴くなる",
   "kana": "",
   "speaker": "",
   "page": 171,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "我が身世になからむ後にあはれとはたれかいはまの水莖の跡",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "見とて返すも世世の家の風ふきつたへよと思ふとをしれ",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "ながめつつ猶もむかしを忍ぶべき月をへだつるわが涙かな",
   "kana": "",
   "speaker": "千",
   "page": 172,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "今日といへば別れし人の名殘よりあやめもつらきものをこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 172,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
